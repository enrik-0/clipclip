# electron-builder hands makensis (32-bit, 260-character path limit) paths that
# go through node_modules/.pnpm. pnpm 9 names the patched app-builder-lib folder
# with up to 120 characters, which pushed the NSIS template path over the limit
# in a checkout under a deep folder. Keep the store folder names short.
virtual-store-dir-max-length=60
